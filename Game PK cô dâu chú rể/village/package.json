{
  "name": "lang-que-viet-nam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Làng Quê Việt Nam: game mô phỏng làng 3D cho TikTok LIVE",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "esbuild src/client/cuoi/main.ts --bundle --minify --sourcemap --target=es2020 --outfile=public/app.js --log-level=warning",
    "start": "npm run chien",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:chien": "esbuild src/chien/client/main.ts --bundle --minify --sourcemap --target=es2020 --outfile=public/chien.js --log-level=warning",
    "chien": "npm run build:chien && node src/chien/server/main.ts",
    "cuoi": "npm run build && node src/server/main.ts",
    "precuoi": "node -e \"process.exit(require('fs').existsSync('node_modules/three') ? 0 : 1)\" || npm install",
    "assets": "node tools/fetch-assets.mjs"
  },
  "dependencies": {
    "msedge-tts": "2.1.1",
    "three": "0.170.0",
    "tiktok-live-connector": "2.5.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "@types/node": "22.19.0",
    "@types/three": "0.170.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.24.2",
    "meshoptimizer": "0.22.0",
    "typescript": "5.8.3"
  }
}
